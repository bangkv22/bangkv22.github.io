---
// FishBackground.astro - Layered Underwater Aquarium Environment
---

<div class="aquarium-environment" aria-hidden="true">
  <!-- Top Sunlight Shafts -->
  <div class="ocean-sun-rays"></div>

  <!-- Rising Bubbles Container -->
  <div class="bubbles-layer">
    <div class="bubble" style="left: 12%; width: 14px; height: 14px; animation-duration: 9s; animation-delay: 0.5s;"></div>
    <div class="bubble" style="left: 28%; width: 22px; height: 22px; animation-duration: 12s; animation-delay: 2s;"></div>
    <div class="bubble" style="left: 45%; width: 10px; height: 10px; animation-duration: 8s; animation-delay: 1.2s;"></div>
    <div class="bubble" style="left: 63%; width: 18px; height: 18px; animation-duration: 11s; animation-delay: 3.5s;"></div>
    <div class="bubble" style="left: 79%; width: 26px; height: 26px; animation-duration: 14s; animation-delay: 0s;"></div>
    <div class="bubble" style="left: 91%; width: 12px; height: 12px; animation-duration: 10s; animation-delay: 4s;"></div>
    <div class="bubble" style="left: 36%; width: 16px; height: 16px; animation-duration: 13s; animation-delay: 5s;"></div>
    <div class="bubble" style="left: 70%; width: 8px; height: 8px; animation-duration: 7s; animation-delay: 2.8s;"></div>
  </div>

  <!-- Swimming Fish Layer (CSS/SVG) -->
  <div class="swimming-creatures">
    <!-- Neon Cyber Fish 1 (Left to Right) -->
    <div class="fish-instance fish-1">
      <svg viewBox="0 0 100 40" class="fish-svg" width="70" height="28">
        <defs>
          <linearGradient id="fishGrad1" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#00f5ff" />
            <stop offset="60%" stop-color="#20e3d2" />
            <stop offset="100%" stop-color="#9b5cff" />
          </linearGradient>
        </defs>
        <!-- Fish Body -->
        <path d="M75,20 Q55,6 20,20 Q55,34 75,20 Z" fill="url(#fishGrad1)" opacity="0.9" />
        <!-- Tail -->
        <path d="M20,20 L5,7 L12,20 L5,33 Z" fill="#00f5ff" opacity="0.8" class="fish-tail-fin" />
        <!-- Fin -->
        <path d="M48,12 Q58,3 62,12 Z" fill="#9b5cff" opacity="0.7" />
        <path d="M44,24 Q54,32 58,24 Z" fill="#20e3d2" opacity="0.7" />
        <!-- Eye -->
        <circle cx="68" cy="18" r="2" fill="#ffffff" />
        <circle cx="68" cy="18" r="3.5" stroke="#00f5ff" stroke-width="0.75" fill="none" />
      </svg>
    </div>

    <!-- Neon Cyber Fish 2 (Right to Left - Slower, Deep) -->
    <div class="fish-instance fish-2">
      <svg viewBox="0 0 100 40" class="fish-svg" width="55" height="22">
        <defs>
          <linearGradient id="fishGrad2" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#ff5db1" />
            <stop offset="70%" stop-color="#9b5cff" />
            <stop offset="100%" stop-color="#00f5ff" />
          </linearGradient>
        </defs>
        <path d="M75,20 Q55,6 20,20 Q55,34 75,20 Z" fill="url(#fishGrad2)" opacity="0.75" />
        <path d="M20,20 L5,8 L10,20 L5,32 Z" fill="#ff5db1" opacity="0.8" />
        <circle cx="68" cy="18" r="2" fill="#ffffff" />
      </svg>
    </div>

    <!-- School of Small Plankton / Nano Fish -->
    <div class="fish-school">
      <div class="nano-fish" style="top: 15%; animation-duration: 22s; animation-delay: 1s;"></div>
      <div class="nano-fish" style="top: 16%; animation-duration: 21s; animation-delay: 1.4s;"></div>
      <div class="nano-fish" style="top: 17%; animation-duration: 23s; animation-delay: 1.1s;"></div>
      <div class="nano-fish" style="top: 18%; animation-duration: 22.5s; animation-delay: 1.6s;"></div>
    </div>

    <!-- Bioluminescent Neon Jellyfish Floating Gracefully -->
    <div class="jellyfish-creature">
      <svg viewBox="0 0 80 120" width="60" height="90">
        <defs>
          <radialGradient id="jellyGrad" cx="50%" cy="30%" r="50%">
            <stop offset="0%" stop-color="#00f5ff" stop-opacity="0.9" />
            <stop offset="60%" stop-color="#9b5cff" stop-opacity="0.6" />
            <stop offset="100%" stop-color="#031321" stop-opacity="0.1" />
          </radialGradient>
        </defs>
        <!-- Jelly Bell -->
        <path d="M15,45 C15,15 65,15 65,45 C55,42 48,46 40,42 C32,46 25,42 15,45 Z" fill="url(#jellyGrad)" stroke="#00f5ff" stroke-width="1.2" />
        <ellipse cx="40" cy="30" rx="14" ry="8" fill="rgba(255,255,255,0.3)" />
        <!-- Inner Glow -->
        <circle cx="40" cy="32" r="4" fill="#00f5ff" filter="drop-shadow(0 0 6px #00f5ff)" />
        <!-- Tentacles -->
        <path d="M25,45 Q20,75 26,105" stroke="#9b5cff" stroke-width="1.5" fill="none" opacity="0.8" />
        <path d="M35,46 Q40,80 34,115" stroke="#00f5ff" stroke-width="2" fill="none" opacity="0.85" />
        <path d="M45,46 Q40,80 46,115" stroke="#00f5ff" stroke-width="2" fill="none" opacity="0.85" />
        <path d="M55,45 Q60,75 54,105" stroke="#ff5db1" stroke-width="1.5" fill="none" opacity="0.8" />
      </svg>
    </div>
  </div>

  <!-- Bottom Sea Floor Corals & Swaying Flora -->
  <div class="sea-floor-flora">
    <!-- Left Seaweed & Coral -->
    <div class="flora-cluster left-flora">
      <svg viewBox="0 0 200 180" class="flora-svg" preserveAspectRatio="none">
        <path d="M20,180 Q10,120 30,70 Q45,25 35,0" stroke="#00f5ff" stroke-width="6" fill="none" stroke-linecap="round" class="seaweed-stem-1" opacity="0.65" />
        <path d="M45,180 Q35,110 60,65 Q70,30 55,5" stroke="#20e3d2" stroke-width="5" fill="none" stroke-linecap="round" class="seaweed-stem-2" opacity="0.6" />
        <path d="M70,180 Q85,130 75,90 Q65,60 80,30" stroke="#9b5cff" stroke-width="4.5" fill="none" stroke-linecap="round" class="seaweed-stem-1" opacity="0.5" />
        <!-- Coral Branch -->
        <path d="M10,180 L18,135 Q22,110 38,100 M18,135 Q10,115 5,95" stroke="#ff5db1" stroke-width="5" fill="none" stroke-linecap="round" opacity="0.75" />
      </svg>
    </div>

    <!-- Right Seaweed & Coral -->
    <div class="flora-cluster right-flora">
      <svg viewBox="0 0 200 180" class="flora-svg" preserveAspectRatio="none">
        <path d="M180,180 Q190,120 170,70 Q155,25 165,0" stroke="#00f5ff" stroke-width="6" fill="none" stroke-linecap="round" class="seaweed-stem-2" opacity="0.65" />
        <path d="M155,180 Q165,110 140,65 Q130,30 145,5" stroke="#20e3d2" stroke-width="5" fill="none" stroke-linecap="round" class="seaweed-stem-1" opacity="0.6" />
        <path d="M130,180 Q115,130 125,90 Q135,60 120,30" stroke="#ff5db1" stroke-width="4.5" fill="none" stroke-linecap="round" class="seaweed-stem-2" opacity="0.6" />
      </svg>
    </div>
  </div>

  <!-- Interactive Cursor Glow Canvas/Div -->
  <div id="cursorGlow" class="cursor-glow"></div>
</div>

<style>
  .aquarium-environment {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .bubbles-layer {
    position: absolute;
    inset: 0;
  }

  .swimming-creatures {
    position: absolute;
    inset: 0;
  }

  .fish-instance {
    position: absolute;
    will-change: transform;
    pointer-events: none;
  }

  .fish-1 {
    top: 28%;
    animation: swim-left-to-right 24s linear infinite;
  }

  .fish-2 {
    top: 65%;
    animation: swim-right-to-left 32s linear infinite;
  }

  .nano-fish {
    position: absolute;
    left: -20px;
    width: 12px;
    height: 4px;
    background: linear-gradient(90deg, #00f5ff, #ffffff);
    border-radius: 4px;
    opacity: 0.55;
    box-shadow: 0 0 6px #00f5ff;
    animation: swim-left-to-right linear infinite;
  }

  .jellyfish-creature {
    position: absolute;
    right: 8%;
    top: 38%;
    animation: jellyfish-pulse 8s ease-in-out infinite;
    filter: drop-shadow(0 0 15px rgba(0, 245, 255, 0.4));
  }

  .sea-floor-flora {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 150px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.85;
  }

  .flora-cluster {
    position: absolute;
    bottom: -10px;
    width: 180px;
    height: 140px;
  }

  .left-flora {
    left: 1rem;
  }

  .right-flora {
    right: 1rem;
  }

  .flora-svg {
    width: 100%;
    height: 100%;
  }

  .seaweed-stem-1 {
    animation: seaweed-sway 7s ease-in-out infinite;
    transform-origin: bottom center;
  }

  .seaweed-stem-2 {
    animation: seaweed-sway-reverse 8.5s ease-in-out infinite;
    transform-origin: bottom center;
  }

  @media (max-width: 768px) {
    .jellyfish-creature {
      display: none;
    }
    .flora-cluster {
      width: 100px;
      height: 90px;
      opacity: 0.5;
    }
    .fish-2 {
      display: none;
    }
  }
</style>

<script>
  // Mouse Glow tracking on desktop
  const cursorGlow = document.getElementById('cursorGlow');
  if (cursorGlow && window.matchMedia('(pointer: fine)').matches) {
    window.addEventListener('mousemove', (e) => {
      cursorGlow.style.left = `${e.clientX}px`;
      cursorGlow.style.top = `${e.clientY}px`;
    });
  }
</script>

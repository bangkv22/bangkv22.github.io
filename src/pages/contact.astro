---
// src/pages/contact.astro
import MainLayout from '../layouts/MainLayout.astro';
import PrismCard from '../components/PrismCard.astro';

const contactInfo = [
  {
    label: 'Địa chỉ Email',
    value: 'bangkv22@gmail.com (hoặc email của bạn)',
    link: 'mailto:bangkv22@gmail.com',
    icon: '✉️'
  },
  {
    label: 'GitHub Profile',
    value: 'github.com/bangkv22',
    link: 'https://github.com/bangkv22',
    icon: '🐙'
  },
  {
    label: 'Mạng xã hội / Kênh khác',
    value: 'LinkedIn / Facebook / Telegram',
    link: '#',
    icon: '🌐'
  },
  {
    label: 'Trạng thái Công việc',
    value: 'Sẵn sàng nhận cơ hội Thực tập & Đồ án',
    link: '#',
    icon: '🚀'
  }
];
---

<MainLayout 
  title="Liên hệ & Kết nối — AQUA PRISM Portfolio"
  description="Kênh liên lạc chính thức với Bang K.V. Hỗ trợ gửi email trực tiếp, trao đổi cơ hội thực tập và hợp tác dự án."
>
  <div class="container" style="padding-top: 3.5rem; padding-bottom: 5rem;">
    <div class="section-header">
      <div class="section-tag">Kênh Liên Lạc • Get in Touch</div>
      <h1 class="section-title">Kết nối với <span class="gradient-text">AQUA PRISM</span></h1>
      <p class="section-subtitle">
        Bạn có câu hỏi, ý tưởng dự án hoặc muốn trao đổi về cơ hội nghề nghiệp? Hãy gửi thư cho mình qua các kênh dưới đây.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Contact Details & Info -->
      <div class="contact-info-col">
        <PrismCard glowColor="purple">
          <h2 style="font-size: 1.45rem; margin-bottom: 1rem; color: var(--text-main);">
            Thông tin Kết nối Trực tiếp
          </h2>
          <p style="font-size: 0.92rem; color: var(--text-muted); margin-bottom: 2rem;">
            Mình luôn chủ động kiểm tra hòm thư và phản hồi nhanh chóng trong vòng 24–48 giờ làm việc.
          </p>

          <div class="contact-cards-list">
            {contactInfo.map((item) => (
              <a href={item.link} class="contact-item-card glass-panel" target={item.link.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                <span class="contact-icon">{item.icon}</span>
                <div>
                  <div class="contact-label">{item.label}</div>
                  <div class="contact-value">{item.value}</div>
                </div>
              </a>
            ))}
          </div>
        </PrismCard>
      </div>

      <!-- Contact Message Form -->
      <div class="contact-form-col">
        <PrismCard glowColor="cyan">
          <h2 style="font-size: 1.45rem; margin-bottom: 0.5rem; color: var(--text-main);">
            Gửi Tin nhắn
          </h2>
          <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1.5rem;">
            Điền nội dung bên dưới để tự động tạo email gửi đến mình qua trình duyệt của bạn (hoặc kết nối backend form tuỳ chọn).
          </p>

          <!-- Real mailto generator form -->
          <form id="aquaContactForm" class="contact-form">
            <div class="form-group">
              <label for="senderName" class="form-label">Họ và Tên của bạn *</label>
              <input 
                type="text" 
                id="senderName" 
                name="name" 
                required 
                placeholder="Ví dụ: Nguyễn Văn A"
                class="form-input" 
              />
            </div>

            <div class="form-group">
              <label for="senderEmail" class="form-label">Email của bạn *</label>
              <input 
                type="email" 
                id="senderEmail" 
                name="email" 
                required 
                placeholder="name@example.com"
                class="form-input" 
              />
            </div>

            <div class="form-group">
              <label for="messageSubject" class="form-label">Chủ đề liên hệ *</label>
              <input 
                type="text" 
                id="messageSubject" 
                name="subject" 
                required 
                placeholder="Cơ hội thực tập / Trao đổi đồ án / Dự án mới"
                class="form-input" 
              />
            </div>

            <div class="form-group">
              <label for="messageContent" class="form-label">Nội dung thư *</label>
              <textarea 
                id="messageContent" 
                name="content" 
                rows="5" 
                required 
                placeholder="Nhập thông điệp bạn muốn gửi gắm..."
                class="form-input"
              ></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
              <span>Mở Email để Gửi Ngay</span>
            </button>
          </form>

          <div style="margin-top: 1.25rem; font-size: 0.8rem; color: var(--text-dim); text-align: center;">
            ℹ️ <em>Hệ thống sẽ mở ứng dụng email của bạn (Gmail, Outlook, v.v.) với nội dung đã được điền sẵn để đảm bảo tính an toàn và minh bạch tuyệt đối.</em>
          </div>
        </PrismCard>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2.5rem;
  }

  .contact-cards-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-item-card {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.1rem 1.4rem;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .contact-icon {
    font-size: 1.6rem;
  }

  .contact-label {
    font-size: 0.8rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .form-input {
    width: 100%;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-sm);
    background: rgba(3, 19, 33, 0.75);
    border: 1px solid var(--border-glass);
    color: var(--text-main);
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
    transition: all 0.25s ease;
  }

  .form-input:focus {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 12px rgba(0, 245, 255, 0.25);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Dynamic mailto handler
  const form = document.getElementById('aquaContactForm') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('senderName') as HTMLInputElement).value;
    const email = (document.getElementById('senderEmail') as HTMLInputElement).value;
    const subject = (document.getElementById('messageSubject') as HTMLInputElement).value;
    const content = (document.getElementById('messageContent') as HTMLTextAreaElement).value;

    const fullSubject = encodeURIComponent(`[AQUA PRISM Portfolio] ${subject}`);
    const fullBody = encodeURIComponent(
      `Chào Bang K.V.,\n\nTôi là: ${name} (${email})\n\nNội dung liên hệ:\n${content}\n\nTrân trọng!`
    );

    window.location.href = `mailto:bangkv22@gmail.com?subject=${fullSubject}&body=${fullBody}`;
  });
</script>

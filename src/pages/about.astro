---
// src/pages/about.astro
import MainLayout from '../layouts/MainLayout.astro';
import PrismCard from '../components/PrismCard.astro';

const timelineEvents = [
  {
    year: '2023 - Nay',
    title: 'Sinh viên Chuyên ngành Công nghệ Thông tin',
    institution: 'Trường Đại học [Tên trường của bạn]',
    description: 'Tập trung nghiên cứu cấu trúc dữ liệu, giải thuật, mạng máy tính, cơ sở dữ liệu quan hệ và kiến trúc web fullstack hiện đại.',
    highlight: 'Điểm trung bình GPA tích lũy xuất sắc, hoàn thành nhiều đồ án chuyên ngành.'
  },
  {
    year: '2024',
    title: 'Đào sâu vào Web Frontend & UI/UX Design',
    institution: 'Tự học & Khóa học Chuyên sâu',
    description: 'Làm chủ JavaScript hiện đại (ES6+), Astro, CSS Modules, Glassmorphism và tối ưu hiệu năng trang web theo chuẩn Core Web Vitals.',
    highlight: 'Xây dựng thành công các hệ thống website tĩnh và ứng dụng client-side mượt mà.'
  },
  {
    year: '2025',
    title: 'Nghiên cứu Backend & Quản trị Cơ sở dữ liệu',
    institution: 'Đồ án Thực hành & Nhóm Lập trình',
    description: 'Thiết kế RESTful API với Node.js / PHP, tối ưu hóa câu lệnh truy vấn SQL Server / MySQL và chuẩn hóa quy trình phân quyền bảo mật.',
    highlight: 'Thực hiện đồ án quản lý cơ sở dữ liệu quy mô vừa đạt đánh giá cao.'
  }
];

const coreValues = [
  {
    title: 'Tư duy Giải quyết Vấn đề (Problem Solving)',
    desc: 'Không chỉ viết code để chạy được, mà luôn phân tích nguyên nhân gốc rễ, tìm kiếm giải pháp tối ưu và lường trước các trường hợp biên (edge cases).'
  },
  {
    title: 'Trách nhiệm & Tinh thần Đồng đội',
    desc: 'Giao tiếp rõ ràng, tôn trọng deadline, tích cực review code và sẵn sàng hỗ trợ các thành viên khác để đưa sản phẩm về đích đúng hẹn.'
  },
  {
    title: 'Khát khao Cập nhật Công nghệ Mới',
    desc: 'Thế giới IT biến chuyển từng ngày. Tôi luôn dành thời gian đọc tài liệu chính thức, thử nghiệm các công nghệ mới và học hỏi từ các cộng đồng mã nguồn mở.'
  }
];
---

<MainLayout 
  title="Về bản thân — AQUA PRISM Portfolio"
  description="Giới thiệu bản thân, mục tiêu nghề nghiệp, câu chuyện học tập và định hướng phát triển của sinh viên IT / Web Developer."
>
  <div class="container" style="padding-top: 3.5rem; padding-bottom: 5rem;">
    <!-- Top Header -->
    <div class="section-header">
      <div class="section-tag">Giới thiệu • About Me</div>
      <h1 class="section-title">Hành trình Khám phá <span class="gradient-text">Đại dương Mã nguồn</span></h1>
      <p class="section-subtitle">
        Một cái nhìn chân thực về xuất phát điểm, đam mê công nghệ và những giá trị cốt lõi tôi hướng tới.
      </p>
    </div>

    <!-- Bio Card & Avatar Split -->
    <div class="about-hero-grid">
      <!-- Avatar Section -->
      <div class="avatar-column">
        <div class="avatar-glow-frame">
          <div class="avatar-inner">
            <!-- Stylized Dev Avatar Vector Placeholder -->
            <svg viewBox="0 0 200 200" class="avatar-svg" width="100%" height="100%">
              <defs>
                <linearGradient id="avGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#00f5ff" />
                  <stop offset="60%" stop-color="#9b5cff" />
                  <stop offset="100%" stop-color="#ff5db1" />
                </linearGradient>
              </defs>
              <circle cx="100" cy="100" r="95" fill="#041a2e" stroke="url(#avGrad)" stroke-width="3" />
              <!-- Silhouette Head -->
              <circle cx="100" cy="72" r="32" fill="#0c3558" stroke="#00f5ff" stroke-width="2" />
              <!-- Tech Glasses -->
              <rect x="76" y="66" width="20" height="12" rx="3" fill="none" stroke="#00f5ff" stroke-width="2.5" />
              <rect x="104" y="66" width="20" height="12" rx="3" fill="none" stroke="#00f5ff" stroke-width="2.5" />
              <line x1="96" y1="72" x2="104" y2="72" stroke="#00f5ff" stroke-width="2" />
              <!-- Torso -->
              <path d="M48,158 C50,122 75,114 100,114 C125,114 150,122 152,158 Z" fill="#07223b" stroke="#9b5cff" stroke-width="2" />
              <polyline points="90,125 100,135 110,125" stroke="#ff5db1" stroke-width="2" fill="none" />
            </svg>
          </div>
          <div class="avatar-status-badge">
            <span class="status-dot"></span>
            <span>Sẵn sàng cho cơ hội Thực tập / Dự án</span>
          </div>
        </div>

        <!-- Download CV / Contact Quick Actions -->
        <div class="cv-action-card glass-panel" style="margin-top: 1.8rem; text-align: center;">
          <h4 style="margin-bottom: 0.5rem; font-size: 1.05rem;">Curriculum Vitae</h4>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.2rem;">
            Tải về bản hồ sơ năng lực chi tiết định dạng PDF hoặc liên hệ phỏng vấn trực tiếp.
          </p>
          <a href="/contact" class="btn btn-primary" style="width: 100%;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Yêu cầu nhận CV PDF</span>
          </a>
        </div>
      </div>

      <!-- Bio Text -->
      <div class="bio-column">
        <PrismCard glowColor="cyan">
          <h2 style="font-size: 1.8rem; margin-bottom: 0.8rem;">
            Tôi là <span class="gradient-text">Bang K.V.</span>
          </h2>
          <div class="meta-tags-row">
            <span class="badge">Chuyên ngành: Kỹ thuật Phần mềm / CNTT</span>
            <span class="badge badge-purple">Định hướng: Frontend & Fullstack Web</span>
            <span class="badge badge-coral">Địa điểm: Việt Nam</span>
          </div>

          <h3 style="margin-top: 1.5rem; margin-bottom: 0.75rem; font-size: 1.25rem; color: var(--neon-cyan);">
            Câu chuyện bắt đầu với Lập trình
          </h3>
          <p>
            Niềm yêu thích công nghệ của tôi nhen nhóm từ những ngày đầu tiếp xúc với máy tính, tò mò về cách các trang web hiển thị nội dung và cách những dòng code có thể tương tác với hàng triệu người dùng khắp toàn cầu.
          </p>
          <p>
            Khi chính thức bước vào giảng đường ngành Công nghệ Thông tin, tôi nhận ra thế giới phần mềm vừa có tính kỷ luật chặt chẽ của tư duy logic toán học, vừa có sự tự do sáng tạo không giới hạn của nghệ thuật giao diện người dùng. Tôi bắt đầu tự tay xây dựng các trang web, thử nghiệm các thư viện mới và từng bước giải quyết các bài toán dữ liệu thực tế.
          </p>

          <h3 style="margin-top: 1.5rem; margin-bottom: 0.75rem; font-size: 1.25rem; color: var(--neon-aqua);">
            Mục tiêu Nghề nghiệp
          </h3>
          <div class="goals-grid">
            <div class="goal-item">
              <span class="goal-bullet">01</span>
              <div>
                <strong>Mục tiêu ngắn hạn:</strong> Tốt nghiệp với kết quả xuất sắc, tham gia thực tập tại môi trường doanh nghiệp công nghệ chuyên nghiệp để trau dồi quy trình làm việc thực chiến (Agile/Scrum).
              </div>
            </div>
            <div class="goal-item">
              <span class="goal-bullet">02</span>
              <div>
                <strong>Mục tiêu dài hạn:</strong> Trở thành một Senior Fullstack Developer có khả năng thiết kế hệ thống lớn, tối ưu hóa trải nghiệm người dùng và chia sẻ kiến thức hữu ích cho cộng đồng lập trình viên trẻ.
              </div>
            </div>
          </div>
        </PrismCard>
      </div>
    </div>

    <!-- Core Values Section -->
    <div style="margin-top: 5rem;">
      <div class="section-header">
        <div class="section-tag">Phong cách & Điểm mạnh</div>
        <h2 class="section-title">Nguyên tắc <span class="gradient-text">Làm việc</span></h2>
      </div>

      <div class="values-grid">
        {coreValues.map((val, idx) => (
          <PrismCard glowColor={idx === 0 ? 'cyan' : idx === 1 ? 'purple' : 'coral'}>
            <h3 style="font-size: 1.2rem; margin-bottom: 0.75rem; color: var(--text-main);">{val.title}</h3>
            <p style="font-size: 0.95rem; margin-bottom: 0;">{val.desc}</p>
          </PrismCard>
        ))}
      </div>
    </div>

    <!-- Education Timeline Section -->
    <div style="margin-top: 5rem;">
      <div class="section-header">
        <div class="section-tag">Lộ trình Phát triển</div>
        <h2 class="section-title">Dòng thời gian <span class="gradient-text">Học vấn</span></h2>
      </div>

      <div class="timeline-container">
        {timelineEvents.map((event) => (
          <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content glass-panel">
              <div class="timeline-year">{event.year}</div>
              <h3 class="timeline-title">{event.title}</h3>
              <div class="timeline-inst">{event.institution}</div>
              <p class="timeline-desc">{event.description}</p>
              <div class="timeline-highlight">
                <span style="color: var(--neon-cyan); font-weight: 600;">Dấu ấn:</span> {event.highlight}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .about-hero-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .avatar-glow-frame {
    position: relative;
    padding: 10px;
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-glass);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(0, 245, 255, 0.2);
  }

  .avatar-inner {
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #020f1b;
  }

  .avatar-svg {
    display: block;
    filter: drop-shadow(0 0 10px rgba(0, 245, 255, 0.3));
  }

  .avatar-status-badge {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    background: rgba(0, 245, 255, 0.08);
    border: 1px solid rgba(0, 245, 255, 0.2);
    font-size: 0.82rem;
    color: var(--neon-cyan);
    font-weight: 500;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00f5ff;
    box-shadow: 0 0 8px #00f5ff;
    animation: bioluminescent-pulse 2s infinite;
  }

  .meta-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .goals-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .goal-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.85rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.92rem;
  }

  .goal-bullet {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--neon-cyan);
    font-size: 1.1rem;
    line-height: 1.2;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .timeline-container {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    padding-left: 2rem;
    border-left: 2px dashed rgba(0, 245, 255, 0.25);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .timeline-marker {
    position: absolute;
    left: -2rem;
    top: 1.5rem;
    transform: translateX(-50%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--neon-cyan);
    border: 3px solid #031321;
    box-shadow: 0 0 10px var(--neon-cyan);
  }

  .timeline-content {
    padding: 1.5rem;
  }

  .timeline-year {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--neon-cyan);
    background: rgba(0, 245, 255, 0.12);
    border: 1px solid rgba(0, 245, 255, 0.25);
    margin-bottom: 0.6rem;
  }

  .timeline-title {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .timeline-inst {
    font-size: 0.88rem;
    color: var(--prism-purple);
    font-weight: 600;
    margin-bottom: 0.8rem;
  }

  .timeline-desc {
    font-size: 0.92rem;
    margin-bottom: 0.6rem;
  }

  .timeline-highlight {
    font-size: 0.85rem;
    color: var(--text-muted);
    padding: 0.4rem 0.7rem;
    background: rgba(0, 0, 0, 0.25);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 900px) {
    .about-hero-grid {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .avatar-column {
      max-width: 320px;
      width: 100%;
    }
    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
